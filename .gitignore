# Dependencies
node_modules/
*/node_modules/
vendor/
backend/vendor/

# Environment files
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Laravel storage & cache
backend/storage/*.key
backend/storage/framework/cache/*
!backend/storage/framework/cache/.gitignore
backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/storage/logs/*
!backend/storage/logs/.gitignore
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore

# Backups and SQL dumps
backend/storage/app/private/backups/*
*.sql

# Logs
*.log
error_log
backend/error_log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Server & cPanel runtime/validation
.well-known/
cgi-bin/

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
