<IfModule php7_module>
   php_value error_log "/home/pant1123/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/pant1123/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# BEGIN Custom Routing Rules
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Satu document root: SPA, aset, dan API dilayani melalui Laravel.
    # Hentikan rewrite root setelah request sudah masuk ke public Laravel.
    RewriteRule ^backend/public(?:/|$) - [L]

    RewriteRule ^$ backend/public/index.php [L,QSA]

    RewriteCond %{DOCUMENT_ROOT}/backend/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/backend/public/$1 -d
    RewriteRule ^(.+)$ backend/public/$1 [L]

    RewriteRule ^ backend/public/index.php [L,QSA]
</IfModule>
# END Custom Routing Rules

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
